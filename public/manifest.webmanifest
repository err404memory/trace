{
  "name": "Trace",
  "short_name": "Trace",
  "description": "Open a location export and explore every point on a map, in a table and over time. Runs on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0D1015",
  "theme_color": "#10141A",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "file",
        "accept": [".csv", "text/csv", "text/comma-separated-values", ".geojson", "application/geo+json", ".json", "application/json", ".gpx", "application/gpx+xml", ".kml", "application/vnd.google-earth.kml+xml", "text/plain", "application/octet-stream"]
      }]
    }
  },
  "file_handlers": [{
    "action": "./",
    "accept": {
      "text/csv": [".csv"],
      "application/geo+json": [".geojson"],
      "application/gpx+xml": [".gpx"],
      "application/vnd.google-earth.kml+xml": [".kml"]
    }
  }]
}
