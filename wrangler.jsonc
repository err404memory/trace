// Cloudflare Worker serving the built app (dist/) as static assets.
// Deployed by Cloudflare Workers Builds on every push to main; see README "Hosting".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Creates the DNS record and certificate for the subdomain on deploy
  // (ghostyashes.com must be a zone in the same Cloudflare account).
  "routes": [{ "pattern": "trace.ghostyashes.com", "custom_domain": true }],
  "workers_dev": false
}
